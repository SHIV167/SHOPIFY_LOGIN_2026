        .contact_form h5 {
            font-size: 18px;
            color: #333333;
            width: 100%;
            display: inline-block;
            margin: 5px 0 20px;
            font-weight: bold;
        }
        .modal-content {
            border-radius: 20px;
            text-align: center;
            width: 100%;
            border: none !important;
            background: #fff;
        }
        .modal-body {
            padding: 20px;
        }
        input[type="text"],
        input[type="email"],
        input[type="tel"],
        input[type="submit"],
        input[type="number"] {
            border: 1px solid #ccc;
            border-radius: 5px;
            background: #f4f4f4;
            padding: 10px;
            width: 75%;
            transition: border-color 0.3s ease;
        }
        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="number"]:focus {
            border-color: #78c2ad; /* Change border color on focus */
            outline: none; /* Remove outline */
        }
        input[type="radio"],
        input[type="checkbox"] {
            margin-right: 10px;
            transform: scale(1.2); /* Scale up checkboxes and radio buttons */
        }
        .health-issues {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-start; /* Aligns items to the start */
            margin-bottom: 20px; /* Adds space below the health issues */
        }
        .form-group {
            flex: 1 1 50%; /* Two items per row */
            display: flex;
            align-items: center;
            margin-bottom: 10px; /* Adds space between items */
        }
        label {
            display: flex;
            align-items: center;
            font-size: 18px;
        }
        .btn-info {
            background-color: #07826a;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }
        .box {
            display: none; /* Initially hide all boxes */
            margin-top: 10px; /* Space above box content */
        }
        .form-image {
            max-width: 100%;
            height: auto;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
        }
        .col-lg-6,
        .col-sm-6 {
            flex: 1;
            padding: 15px;
            box-sizing: border-box;
        }
        @media (max-width: 768px) {
            .form-group {
                flex: 1 1 100%; /* Stack items on smaller screens */
            }
            .col-lg-6,
            .col-sm-6 {
                flex: 1 1 100%; /* Full width on small screens */
            }
            .form-image {
                width: 100%; /* Make the image full width */
            }
            .modal-content {
                padding: 10px; /* Reduce padding */
            }
        }
      </style>

      <script>
        function toggleBox(issue) {
            // Hide all boxes first
            document.querySelectorAll('.box').forEach(box => {
                box.style.display = 'none';
            });

            // Show the selected box
            const selectedBox = document.querySelector('.' + issue + '.box');
            if (selectedBox) {
                selectedBox.style.display = 'block';
            }
        }

        document.querySelector("form").addEventListener("submit", function (e) {
            const healthIssues = document.querySelector('input[name="healthissues"]:checked');
            if (!healthIssues) {
                e.preventDefault(); // Prevent form submission
                alert("Please select at least one health issue.");
            }
        });
      </script>
    </body>
  </html>
{% endif %}

