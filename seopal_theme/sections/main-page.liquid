      <title>Sheopals Section</title>
      <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
        }

        .testimonialstoryblock {
            width: 100%;
