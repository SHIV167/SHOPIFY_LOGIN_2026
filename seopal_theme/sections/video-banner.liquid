{% schema %}
{
  "name": "Full-Width Video Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Full-Width Video Banner"
    },
    {
      "type": "url",
      "id": "video_url_desktop",
      "label": "Desktop Video URL",
      "info": "Supports YouTube or direct video file URL for desktop"
    },
    {
      "type": "url",
      "id": "video_url_mobile",
      "label": "Mobile Video URL",
      "info": "Supports YouTube or direct video file URL for mobile"
    },
    {
      "type": "checkbox",
      "id": "enable_sound",
      "label": "Enable sound",
      "default": false,
      "info": "If unchecked, video will be muted"
    }
  ],
  "presets": [
    {
      "name": "Full-Width Video Banner",
      "category": "Video"
    }
  ]
}
{% endschema %}

<div class="video-banner">
  <h2 class="video-banner__heading">{{ section.settings.heading }}</h2>
  <div class="video-banner__container">
    <div class="video-banner__desktop">
      {% if section.settings.video_url_desktop contains 'youtube.com'
        or section.settings.video_url_desktop contains 'youtu.be'
      %}
        <div class="video-banner__youtube" data-sound="{{ section.settings.enable_sound }}" data-desktop="true">
          {% assign youtube_id_desktop = section.settings.video_url_desktop | split: 'v=' | last | split: '&' | first %}
          <div id="youtube-player-desktop"></div>
        </div>
      {% else %}
        <video
          class="video-banner__video video-banner__video--desktop"
          src="{{ section.settings.video_url_desktop }}"
          {% unless section.settings.enable_sound %}
            muted
          {% endunless %}
          autoplay
          loop
          playsinline
        >
          Your browser does not support the video tag.
        </video>
      {% endif %}
    </div>

    <div class="video-banner__mobile">
      {% if section.settings.video_url_mobile contains 'youtube.com'
        or section.settings.video_url_mobile contains 'youtu.be'
      %}
        <div class="video-banner__youtube" data-sound="{{ section.settings.enable_sound }}" data-mobile="true">
          {% assign youtube_id_mobile = section.settings.video_url_mobile | split: 'v=' | last | split: '&' | first %}
          <div id="youtube-player-mobile"></div>
        </div>
      {% else %}
        <video
          class="video-banner__video video-banner__video--mobile"
          src="{{ section.settings.video_url_mobile }}"
          {% unless section.settings.enable_sound %}
            muted
          {% endunless %}
          autoplay
          loop
          playsinline
        >
          Your browser does not support the video tag.
        </video>
      {% endif %}
    </div>
  </div>
</div>

<style>
    .video-banner__desktop {
      display: block;
    }

    .video-banner__mobile {
      display: none;
    }

    @media screen and (max-width: 768px) {
      .video-banner__desktop {
        display: none;
      }

      .video-banner__mobile {
        display: block;
      }
    }

    .video-banner__heading {
      text-align: center;
      margin-bottom: 1rem;
      padding: 0 1rem;
    }


    .video-banner__container {
    position: relative;
    width: 100%;
    height: 100%; /* Full viewport height */
    /* Removed background-color */
  }

  .video-banner__video,
  .video-banner__youtube {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain; /* Ensure the video covers the entire container */
    background-color: transparent; /* Ensure no background color */
  }
</style>

<script src="https://www.youtube.com/iframe_api"></script>
<script>
  var playerDesktop, playerMobile;

  function onYouTubeIframeAPIReady() {
    var desktopContainer = document.querySelector('.video-banner__youtube[data-desktop="true"]');
    var mobileContainer = document.querySelector('.video-banner__youtube[data-mobile="true"]');

    if (desktopContainer) {
      var enableSoundDesktop = desktopContainer.dataset.sound === 'true';
      playerDesktop = new YT.Player('youtube-player-desktop', {
        height: '100%',
        width: '100%',
        videoId: '{{ youtube_id_desktop }}',
        playerVars: {
          'autoplay': 1,
          'loop': 1,
          'playlist': '{{ youtube_id_desktop }}',
          'controls': 1,
          'mute': enableSoundDesktop ? 0 : 1,
          'playsinline': 1,
          'rel': 0,
          'showinfo': 0,
          'modestbranding': 1
        },
        events: {
          'onReady': onPlayerReady
        }
      });
    }

    if (mobileContainer) {
      var enableSoundMobile = mobileContainer.dataset.sound === 'true';
      playerMobile = new YT.Player('youtube-player-mobile', {
        height: '100%',
        width: '100%',
        videoId: '{{ youtube_id_mobile }}',
        playerVars: {
          'autoplay': 1,
          'loop': 1,
          'playlist': '{{ youtube_id_mobile }}',
          'controls': 1,
          'mute': enableSoundMobile ? 0 : 1,
          'playsinline': 1,
          'rel': 0,
          'showinfo': 0,
          'modestbranding': 1
        },
        events: {
          'onReady': onPlayerReady
        }
      });
    }
  }

  function onPlayerReady(event) {
    event.target.playVideo();
  }
</script>
