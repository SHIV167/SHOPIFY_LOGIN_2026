<div class="read-more-section">
  <p class="read-more-content">
    {{ section.settings.initial_content }}
    <span class="more-content" style="display:none;">
      {{ section.settings.additional_content }}
    </span>
  </p>
  <button class="read-more-btn" aria-expanded="false">Read More</button>
</div>

<style>
  .read-more-section {
      margin: 0px 60px; /* Top and bottom margin for the section */
  }
  .read-more-content {
      padding: 15px;
      margin: 0 20px; /* Add left and right margin */
      background-color: #f9f9f9;
      border-radius: 5px;
      transition: max-height 0.3s ease; /* Optional: smooth transition */
  }
  .read-more-btn {
      background-color: #007bff;
      color: white;
      border: none;
      padding: 10px 15px;
      cursor: pointer;
      margin-top: 10px;
  }
  .read-more-btn:hover {
      background-color: #0056b3;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
      const readMoreBtn = document.querySelector('.read-more-btn');
      const moreContent = document.querySelector('.more-content');

      readMoreBtn.addEventListener('click', function() {
          if (moreContent.style.display === "none") {
              moreContent.style.display = "inline";
              readMoreBtn.textContent = "Read Less";
              readMoreBtn.setAttribute("aria-expanded", "true");
          } else {
              moreContent.style.display = "none";
              readMoreBtn.textContent = "Read More";
              readMoreBtn.setAttribute("aria-expanded", "false");
          }
      });
  });
</script>

{% schema %}
{
  "name": "Read More Section",
  "settings": [
    {
      "type": "richtext",
      "id": "initial_content",
      "label": "Initial Content",
      "default": "<p>Here is some initial content that will be visible.</p>"
    },
    {
      "type": "richtext",
      "id": "additional_content",
      "label": "Additional Content",
      "default": "<p>This is the additional content that will be shown when 'Read More' is clicked.</p>"
    }
  ],
  "presets": [
    {
      "name": "Read More Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
