{% comment %}
  custom-header.liquid
{% endcomment %}

<div class="custom-header">
  <div class="page-width">
    <div class="custom-header__content">
      <nav class="custom-header__menu" role="navigation">
        <ul class="custom-header__menu-items list-unstyled">
          {% for link in linklists['main-menu'].links %}
            <li class="custom-header__menu-item{% if link.active %} custom-header__menu-item--active{% endif %}">
              <a href="{{ link.url }}" class="custom-header__menu-link">
                {{ link.title }}
              </a>
              {% if link.links != blank %}
                <div class="custom-header__submenu">
                  <ul class="custom-header__submenu-items list-unstyled">
                    {% for childlink in link.links %}
                      <li class="custom-header__submenu-item">
                        <a href="{{ childlink.url }}" class="custom-header__submenu-link">
                          {{ childlink.title }}
                        </a>
                        {% if childlink.type == 'collection' %}
                          <a href="{{ childlink.url }}" class="custom-header__buy-now-button">BUY NOW</a>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-header {
    background-color: #f8f8f8;
    padding: 1rem 0;
  }

  .custom-header__menu-items {
    display: flex;
    justify-content: space-around;
  }

  .custom-header__menu-item {
    position: relative;
  }

  .custom-header__submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: #fff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    z-index: 10;
  }

  .custom-header__menu-item:hover .custom-header__submenu {
    display: block;
  }

  .custom-header__buy-now-button {
    display: inline-block;
    background-color: #4CAF50;
    color: white;
    padding: 5px 10px;
    margin-left: 10px;
    text-decoration: none;
    border-radius: 3px;
  }
{% endstylesheet %}

{% javascript %}
  // Add any necessary JavaScript here
{% endjavascript %}
