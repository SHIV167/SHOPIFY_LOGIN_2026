{% schema %}
{
  "name": "Product Hotspots",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product URL"
        },
        {
          "type": "range",
          "id": "left_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "top_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top Position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Hotspots",
      "category": "Image"
    }
  ]
}
{% endschema %}

<style>
  .hotspot-container {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
  }

  .hotspot-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hotspot {
    position: absolute;
    width: 30px; /* Increased size for visibility */
    height: 30px; /* Increased size for visibility */
    border-radius: 50%;
    background-color: rgba(0, 0, 255, 0.7); /* Changed to blue for better visibility */
    border: 2px solid #000;
    cursor: pointer;
    transition: transform 0.3s ease;
    z-index: 10; /* Ensure it's above other elements */
  }

  .hotspot:hover {
    transform: scale(1.2);
  }

  .hotspot-tooltip {
    position: absolute;
    background-color: #fff;
    padding: 5px 10px;
    border-radius: 4px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hotspot:hover .hotspot-tooltip {
    opacity: 1;
  }
</style>

<div class="hotspot-container">
  {% if section.settings.background_image %}
    {{
      section.settings.background_image
      | image_url: width: 1500
      | image_tag: class: 'hotspot-image', loading: 'lazy'
    }}
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'hotspot-image placeholder' }}
  {% endif %}

  {% for block in section.blocks %}
    {% if block.type == 'hotspot' %}
      <a
        href="{{ block.settings.product_url }}"
        class="hotspot"
        style="left: {{ block.settings.left_position }}%; top: {{ block.settings.top_position }}%;"
      >
        <div class="hotspot-tooltip">{{ block.settings.product_title }}</div>
      </a>
    {% endif %}
  {% endfor %}
</div>
