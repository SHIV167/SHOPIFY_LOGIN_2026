{% doc %}
  @prompt
    faqs for seo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-seo-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-faq-seo-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.spacing_between_items }}px;
  }

  .ai-faq-seo-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px 0;
  }

  .ai-faq-seo-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-faq-seo-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-faq-seo-item-{{ ai_gen_id }} {
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    margin-bottom: {{ block.settings.spacing_between_items }}px;
    overflow: hidden;
    background-color: {{ block.settings.item_background_color }};
  }

  .ai-faq-seo-question-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.question_background_color }};
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    font-size: {{ block.settings.question_size }}px;
    color: {{ block.settings.question_color }};
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-faq-seo-question-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.question_hover_color }};
  }

  .ai-faq-seo-question-text-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-faq-seo-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-seo-item-{{ ai_gen_id }}.active .ai-faq-seo-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-seo-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    padding: 0 {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.answer_background_color }};
  }

  .ai-faq-seo-item-{{ ai_gen_id }}.active .ai-faq-seo-answer-{{ ai_gen_id }} {
    max-height: 1000px;
    padding: {{ block.settings.item_padding }}px;
  }

  .ai-faq-seo-answer-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.answer_size }}px;
    color: {{ block.settings.answer_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-seo-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-faq-seo-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-faq-seo-question-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.question_size }}px * 0.9);
    }
  }
{% endstyle %}

<faq-seo-{{ ai_gen_id }} class="ai-faq-seo-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.description != blank %}
    <div class="ai-faq-seo-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-faq-seo-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-faq-seo-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  {% endif %}

  <ul class="ai-faq-seo-list-{{ ai_gen_id }}" itemscope itemtype="https://schema.org/FAQPage">
    {% for i in (1..10) %}
      {% liquid
        assign question_key = 'question_' | append: i
        assign answer_key = 'answer_' | append: i
        assign question = block.settings[question_key]
        assign answer = block.settings[answer_key]
      %}

      {% if question != blank and answer != blank %}
        <li class="ai-faq-seo-item-{{ ai_gen_id }}" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <button
            class="ai-faq-seo-question-{{ ai_gen_id }}"
            aria-expanded="false"
            data-faq-question
          >
            <span class="ai-faq-seo-question-text-{{ ai_gen_id }}" itemprop="name">{{ question }}</span>
            <svg class="ai-faq-seo-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="ai-faq-seo-answer-{{ ai_gen_id }}" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div class="ai-faq-seo-answer-content-{{ ai_gen_id }}" itemprop="text">{{ answer }}</div>
          </div>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</faq-seo-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqSeo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.questions = this.querySelectorAll('[data-faq-question]');
        this.setupEventListeners();
        
        if (this.questions.length > 0 && {{ block.settings.first_item_open }}) {
          this.toggleItem(this.questions[0]);
        }
      }

      setupEventListeners() {
        this.questions.forEach((question) => {
          question.addEventListener('click', () => {
            this.toggleItem(question);
          });
        });
      }

      toggleItem(questionButton) {
        const item = questionButton.closest('.ai-faq-seo-item-{{ ai_gen_id }}');
        const isActive = item.classList.contains('active');

        if ({{ block.settings.allow_multiple_open }} === false) {
          this.querySelectorAll('.ai-faq-seo-item-{{ ai_gen_id }}').forEach((otherItem) => {
            if (otherItem !== item) {
              otherItem.classList.remove('active');
              const otherButton = otherItem.querySelector('[data-faq-question]');
              if (otherButton) {
                otherButton.setAttribute('aria-expanded', 'false');
              }
            }
          });
        }

        item.classList.toggle('active');
        questionButton.setAttribute('aria-expanded', !isActive);
      }
    }

    customElements.define('faq-seo-{{ ai_gen_id }}', FaqSeo{{ ai_gen_id }});
  })();
</script>

