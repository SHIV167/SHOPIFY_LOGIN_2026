<style>
  .slick-prev:before, .slick-next:before{
    color:#000;
  }
  .slick-prev:hover, .slick-prev:focus, .slick-next:hover, .slick-next:focus {
    color: transparent;
    outline: none;
    background: #ffffffbf;
  }
  .slick-next, .slick-prev {
    background: #fff;
    border-radius: 100px;
    height: 40px;
    width: 40px;
    box-shadow: 0px 0px 18px #0000002b;
  }
  .slick-next {
    right: 25px;
  }
  .slick-prev {
    left: 25px;
    z-index: 999;
  }
  .slick-slide img {
    width: 100%;
  }
  .slick-initialized .slick-slide{
    margin: 10px;
  }
  .slideshow-item p{
    margin: 0px;
  }
</style>

<div class="container" style="max-width:100%;">
  <div class="carousel-main">
    {% for variant in product.variants %}
      <div
        class="carousel-cell"
      >
        <img
          src="{{ variant.image | img_url:'master' }}"
          alt="{{ variant.image.alt | escape }}"
        >
      </div>
    {% endfor %}
  </div>
  <div class="carousel-nav">
    {% for variant in product.variants %}
      <div
        class="carousel-cell prod_img{{ variant.id }}"
        id="{{ variant.id }}"
      >
        <img
          src="{{ variant.image | img_url:'450x'}}"
          alt="{{ variant.image.alt | escape }}"
        >
      </div>
    {% endfor %}
  </div>
</div>
