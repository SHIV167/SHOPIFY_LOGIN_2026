{%- comment -%}
  LoginRegister App Embed Widget
  This snippet embeds the custom login/register app via iframe.
  Make sure to set the app_host below to your deployed app URL.
{%- endcomment -%}

{%- assign app_host = 'https://shopify-login-2026.onrender.com' -%}

<div id="lr-overlay" class="lr-overlay" style="display:none;">
  <div class="lr-modal">
    <button class="lr-close" onclick="lrCloseModal()" aria-label="Close">&times;</button>
    <iframe
      id="lr-iframe"
      src="{{ app_host }}/embed?shop={{ shop.permanent_domain | url_encode }}"
      frameborder="0"
      allow="clipboard-write"
      title="Login / Register"
    ></iframe>
  </div>
</div>

<script>
  (function() {
    var overlay = document.getElementById('lr-overlay');
    var iframe = document.getElementById('lr-iframe');
    var baseUrl = '{{ app_host }}/embed?shop={{ shop.permanent_domain | url_encode }}';

    function getStoredCustomer() {
      try {
        var raw = localStorage.getItem('lr_customer');
        return raw ? JSON.parse(raw) : null;
      } catch (e) { return null; }
    }

    window.lrOpenModal = function(mode) {
      var url = baseUrl;
      if (mode) url += '&mode=' + encodeURIComponent(mode);
      if (mode === 'profile') {
        var c = getStoredCustomer();
        if (c) url += '&customer=' + encodeURIComponent(JSON.stringify(c));
      }
      iframe.src = url;
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    };

    window.lrCloseModal = function() {
      overlay.style.display = 'none';
      iframe.src = 'about:blank';
      document.body.style.overflow = '';
    };

    // Close on click outside
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) lrCloseModal();
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.style.display === 'flex') lrCloseModal();
    });

    // Message from iframe for auto-resize, login success, logout, profile
    window.addEventListener('message', function(e) {
      if (e.origin !== '{{ app_host }}') return;
      if (e.data && e.data.type === 'lr_login_success' && e.data.customer) {
        localStorage.setItem('lr_customer', JSON.stringify(e.data.customer));
        lrCloseModal();
        // Optionally reload to reflect logged-in state
        window.location.reload();
      }
      if (e.data && e.data.type === 'lr_logout') {
        localStorage.removeItem('lr_customer');
        lrCloseModal();
        window.location.reload();
      }
      if (e.data && e.data.type === 'lr_request_customer') {
        var c = getStoredCustomer();
        if (iframe && iframe.contentWindow) {
          iframe.contentWindow.postMessage({ type: 'lr_customer_data', customer: c }, '{{ app_host }}');
        }
      }
      if (e.data && e.data.type === 'lr_resize' && e.data.height) {
        iframe.style.height = e.data.height + 'px';
      }
    });
  })();
</script>

<style>
  .lr-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .lr-modal {
    background: #fff;
    border-radius: 8px;
    width: 100%;
    max-width: 420px;
    max-height: 90vh;
    overflow: hidden;
    position: relative;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
  }
  .lr-modal iframe {
    width: 100%;
    height: 520px;
    display: block;
  }
  .lr-close {
    position: absolute;
    top: 8px;
    right: 12px;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #666;
    z-index: 10;
  }
  .lr-close:hover { color: #000; }
  @media (max-width: 480px) {
    .lr-modal { max-height: 95vh; }
    .lr-modal iframe { height: 480px; }
  }
</style>
