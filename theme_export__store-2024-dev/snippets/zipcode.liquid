{% comment %}
  Add this to your product template file (e.g., product.liquid)
{% endcomment %}

{% assign valid_pincodes = settings.valid_pincodes | split: ',' | map: 'strip' %}

<style>
  .pincode-checker {
    margin-top: 20px;
    padding: 20px;
    border: 1px solid #ddd;
    background-color: #f9f9f9;
    border-radius: 8px;
    max-width: 400px;
  }

  .pincode-checker h3 {
    font-size: 18px;
    margin-bottom: 15px;
    color: #333;
  }

  #pincode-input {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
  }

  #pincode-input:focus {
    outline: none;
    border-color: #007bff;
  }

  #submit {
    margin-top: 10px;
    padding: 10px 15px;
    background-color: #007bff;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    width: 100%;
  }

  #submit:hover {
    background-color: #0056b3;
  }

  #pincode-result {
    margin-top: 15px;
    font-size: 14px;
  }

  #pincode-result.success {
    color: {{ settings.success_color | default: '#28a745' }};
  }

  #pincode-result.error {
    color: {{ settings.error_color | default: '#dc3545' }};
  }

  .disabled {
    pointer-events: none;
    opacity: 0.5;
  }
</style>

<div class="pincode-checker">
  <h3>Check Delivery Availability</h3>
  <input type="text" id="pincode-input" placeholder="Enter your pincode" required>
  <button type="submit" id="submit">Check</button>
  <p id="pincode-result"></p>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var result = document.getElementById('pincode-result');
    var pincodeInput = document.getElementById('pincode-input');
    var validPincodes = [{{ settings.valid_pincodes }}];
    console.log(validPincodes);
    var successMessage = {{ settings.success_message | json | default: 'Delivery is available in your area!' }};
    var errorMessage = {{ settings.error_message | json | default: 'Sorry, delivery is not available for this pincode.' }};
    var emptyMessage = 'Please add pincode';

    var addToCartButton = document.querySelector('[name="add"]');
    var buyNowButton = document.querySelector('.shopify-payment-button');

    function checkPincode() {
      var input = pincodeInput.value.trim();

      if (input === '') {
        result.textContent = emptyMessage;
        result.className = 'error';
        pincodeInput.focus();  // Auto-focus on the pincode input field if empty
        // Disable Add to Cart and Buy Now buttons
        addToCartButton.classList.add('disabled');
        buyNowButton.classList.add('disabled');
        return;
      }

      if (validPincodes.includes(parseInt(input))) {
        result.textContent = successMessage;
        result.className = 'success';
        // Enable Add to Cart and Buy Now buttons
        addToCartButton.classList.remove('disabled');
        buyNowButton.classList.remove('disabled');
      } else {
        result.textContent = errorMessage;
        result.className = 'error';
        // Disable Add to Cart and Buy Now buttons
        addToCartButton.classList.add('disabled');
        buyNowButton.classList.add('disabled');
      }
    }

    var btnclick = document.getElementById('submit');
    btnclick.addEventListener('click', function(e) {
      e.preventDefault();
      checkPincode();
    });
  });
</script>
