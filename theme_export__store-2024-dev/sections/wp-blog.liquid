{% schema %}
{
  "name": "wp-blog",
  "settings": [],
  "presets": [{"name": "wp-blog"}],

}
{% endschema %}
<div class="main-container">
  <h1>WELCOME TO MY BLOGS</h1>
</div>
<script>
let url = 'https://webimpressions.online/wp-json/wp/v2/posts?order=desc&per_page=3&_embed';

fetch(url)
  .then(function(response) {
    return response.json();
  })
  .then(function(data) {
    console.log(data);
    result(data);
  })
  .catch(function(error) {
    console.log(error);
  });

function result(data) {
  let html = '';
  for (let item of data) {
    let finaldata = `
      <div class="blog-grid">
        <a href="${item.link}"><img src="${item._embedded['wp:featuredmedia'][0].source_url}" alt="${item.title.rendered}" /><//></a>
        <h3>${item.title.rendered}</h3>
        <p>${new Date(item.date).toLocaleDateString()}</p>
      </div>
    `;
    html += finaldata;
  }
  let container = document.getElementById('blogdata');
  container.innerHTML = html;
}
</script>
<div id="blogdata" class="blogdatacont"></div>
{% stylesheet %}
  .main-container{text-align: center;}
    .blogdatacont {
      display: flex;
      justify-content: space-evenly;
      flex-wrap: wrap;
      width: 100%;
      transition: all linear 1s;
  }
    .blog-grid {
     flex: 1 1 300px;
     margin: 0 auto;
      transition: all linear 1s;
      padding: 18px 18px;

  }
  .blog-grid  p, h3{text-align: center;}
  .blog-grid  img{border-radius: 20px;filter: drop-shadow(4px 3px 4px black);width:100%;}
  .blog-grid  img:hover{transition: all fade 1s;}
  .blog-grid  img:hover{transform: scale(1.1);scale(2);box-shadow: 0px 0px 19px #333;}
{% endstylesheet %}
