{%- comment -%}
  LoginRegister App - Inline embed for /account/login.
  The default Shopify login/register form has been replaced by the custom app's embed.
  Update app_host below if your deployed app URL changes.
{%- endcomment -%}

{%- assign app_host = 'https://loginshopifyapp.shivjhawebtech.info' -%}

{%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .lr-inline-wrapper {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 24px 16px;
    }
    .lr-inline-card {
      width: 100%;
      max-width: 460px;
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.08);
      overflow: hidden;
    }
    .lr-inline-card iframe {
      width: 100%;
      min-height: 560px;
      border: 0;
      display: block;
    }
{%- endstyle -%}

<div class="lr-inline-wrapper section-{{ section.id }}-padding">
  <div class="lr-inline-card">
    <iframe
      id="lr-inline-iframe"
      src="{{ app_host }}/embed?shop={{ shop.permanent_domain | url_encode }}&mode=login"
      title="Login / Register"
      allow="clipboard-write"
    ></iframe>
  </div>
</div>

<script>
  (function() {
    var iframe = document.getElementById('lr-inline-iframe');
    var appHost = '{{ app_host }}';
    var returnUrl = {{ request.path | json }};

    function getStoredCustomer() {
      try {
        var raw = localStorage.getItem('lr_customer');
        return raw ? JSON.parse(raw) : null;
      } catch (e) { return null; }
    }

    // If already logged in, switch the iframe to profile mode immediately
    var existing = getStoredCustomer();
    if (existing) {
      var url = appHost + '/embed?shop={{ shop.permanent_domain | url_encode }}&mode=profile&customer=' + encodeURIComponent(JSON.stringify(existing));
      iframe.src = url;
    }

    window.addEventListener('message', function(e) {
      if (e.origin !== appHost) return;
      if (e.data && e.data.type === 'lr_login_success' && e.data.customer) {
        localStorage.setItem('lr_customer', JSON.stringify(e.data.customer));
        // Redirect to original return_url if any, else home
        var params = new URLSearchParams(window.location.search);
        var ret = params.get('return_url') || params.get('checkout_url') || '/';
        window.location.href = ret;
      }
      if (e.data && e.data.type === 'lr_logout') {
        localStorage.removeItem('lr_customer');
        window.location.href = '/';
      }
      if (e.data && e.data.type === 'lr_request_customer') {
        if (iframe && iframe.contentWindow) {
          iframe.contentWindow.postMessage({ type: 'lr_customer_data', customer: getStoredCustomer() }, appHost);
        }
      }
      if (e.data && e.data.type === 'lr_resize' && e.data.height) {
        iframe.style.height = Math.max(560, e.data.height + 24) + 'px';
      }
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
