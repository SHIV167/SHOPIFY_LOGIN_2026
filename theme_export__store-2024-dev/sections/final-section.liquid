{% schema %}
{
  "name": "Half Image Half Slider",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection for Product Slider"
    }
  ],
  "presets": [
    {
      "name": "Half Image Half Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="container section-container py-4">
  <div class="row half-image-half-slider">
    <div class="col-12 col-md-6 half-image mb-4 mb-md-0">
      {% if section.settings.image %}
        {{ section.settings.image | img_url: '800x' | img_tag: section.settings.image.alt, 'img-fluid rounded' }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'img-fluid rounded' }}
      {% endif %}
    </div>
    <div class="col-12 col-md-6 half-slider">
      {% if section.settings.collection %}
        <div class="product-slider swiper" style="margin-left: 30px;">
          <div class="swiper-wrapper">
            {% for product in collections[section.settings.collection].products limit: 8 %}
              <div class="product-card swiper-slide product-slide text-center p-3 border rounded">
                {% if product.compare_at_price > product.price %}
                  {% assign price_difference = product.compare_at_price | minus: product.price %}
                  {% assign discount_percentage = price_difference
                    | times: 100
                    | divided_by: product.compare_at_price
                  %}
                  <div
                    class="product-image-container"
                    data-product-video="{{ product.metafields.custom.product_video_url }}"
                  ></div>
                  <br>
                  <div class="product-badge">{{ discount_percentage | round: 0 }}% Off</div>
                  <div class="product-card">
                    <!-- Existing product code (e.g., image, title) -->
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      style="
                        z-index: 999999;
                        margin: 34px;
                      "
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                    >
                      <g id="bolt_black_24dp" transform="translate(0 -0.38)"><g id="Group_25330" data-name="Group 25330"><rect id="Rectangle_7532" data-name="Rectangle 7532" width="16" height="16" transform="translate(0 0.38)" fill="none"></rect></g><g id="Group_25331" data-name="Group 25331" transform="translate(4.779 2.047)"><path id="Path_116096" data-name="Path 116096" d="M9.731,15.285H9.048l.682-4.777H7.342c-.6,0-.225-.512-.212-.532Q8.451,7.641,11.1,3h.682L11.1,7.777h2.4c.273,0,.423.13.273.45Q9.727,15.281,9.731,15.285Z" transform="translate(-7.002 -3)" fill="#fff"></path></g></g>
                    </svg>
                    <div class="product-timer" id="timer-{{ product.id }}"></div>
                  </div>
                  <script>
                    document.addEventListener("DOMContentLoaded", function() {
                      // Set the end date for the countdown (example date)
                      var endDate = new Date("Oct 31, 2024 23:59:59").getTime(); // Adjust this date for all products

                      // Create a function to update the countdown for each product
                      function updateCountdown() {
                        var now = new Date().getTime();
                        var timeRemaining = endDate - now;

                        var days = Math.floor(timeRemaining / (1000 * 60 * 60 * 24));
                        var hours = Math.floor((timeRemaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                        var minutes = Math.floor((timeRemaining % (1000 * 60 * 60)) / (1000 * 60));
                        var seconds = Math.floor((timeRemaining % (1000 * 60)) / 1000);

                        // Update all countdown labels on the product cards
                        document.querySelectorAll('.product-timer').forEach(function(timer) {
                          timer.innerHTML =  hours + "h " + minutes + "m " + seconds + "s ";
                        });

                        // If the countdown is over, display an expired message
                        if (timeRemaining < 0) {
                          clearInterval(countdownTimer);
                          document.querySelectorAll('.product-timer').forEach(function(timer) {
                            timer.innerHTML = "Sale Ended";
                          });
                        }
                      }

                      // Update countdown every second
                      var countdownTimer = setInterval(updateCountdown, 1000);
                    });
                  </script>
                {% endif %}
                <a href="{{ product.url }}" class="text-decoration-none">
                  {{
                    product.featured_image
                    | img_url: '300x300'
                    | img_tag: product.title, 'img-fluid mb-2 swiper-lazy'
                  }}

                  <h2 class="product-title">{{ product.title }}</h2>
                  <div class="rating">
                    <!-- You can use a loop to generate stars -->
                    <span>★★★★★</span>
                    <span class="review-count">{{ product.reviews_count }} reviews</span>
                  </div>
                  <div class="rating">
                    <span
                      ><button class="add-to-cart" data-product-id="{{ product.variants.first.id }}">
                        Add to Cart
                      </button></span
                    >
                  </div>
                  <div class="swiper-lazy-preloader"></div>

                  <div class="price">
                    <span class="original-price">{{ product.compare_at_price | money }}</span>
                    <span class="sale-price">{{ product.price | money }}</span>
                  </div>
                </a>
              </div>
            {% endfor %}
          </div>
          <br>
          <div class="swiper-pagination"></div>
        </div>
      {% else %}
        <p class="text-center text-muted">Please select a collection in the section settings.</p>
      {% endif %}
    </div>
  </div>
</div>
<style>
  .video-badge{padding: 0px 48px ;
    position: absolute;
    top: -80px ;
    left: 72px ;
    right: 0px ;
    cursor: pointer;}
  svg{position: absolute;}

  .product-image-container{position: absolute;
    top: 65px ;
    left: 19px ;
    }
  .swiper-wrapper{box-sizing: border-box;}
    img.img-fluid.rounded {
      max-width: 100%;
  }
      .product-card {
      border: 1px solid #ebebeb;
      padding: 0px;
      text-align: center;
      position: relative;
        box-shadow: 0px 0px 10px #80808047;
      border-radius: 10px;
      padding: 05px;
      margin-bottom: 10px;

    }

    .product-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      background-color: #ff4747;
      color: #fff;
      padding: 23px 10px;
      font-size: 12px;
      border-radius: 50%;
    }

    .product-title {
      font-size: 16px;
      margin: 15px 0;
    }

    .rating {
      margin: 10px 0;
    }

    .rating span {
      color: #ff9900;
      font-size: 14px;
    }

    .price {
      margin: 10px 0;
    }

    .original-price {
      text-decoration: line-through;
      color: #777;
      margin-right: 5px;
    }

    .sale-price {
      color: #4CAF50;
      font-size: 18px;
      font-weight: bold;
    }

      duct-slider {
            position: relative;
            padding-bottom: 40px;


          }
          .swiper-pagination-bullet-active {
            background-color: #000;
          }
   .swiper-pagination {
            margin-top: 100px;
          }
          .product-container {
            border: 11px solid #e0e0e0;
            border-radius: 8px;
            padding: 15px;
            transition: box-shadow 0.3s ease;
            box-shadow: 0px 0px 50px #80808047;
            border-radius: 10px;
            padding: 05px;


          }
          .product-container:hover {
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
          }
          .product-title {
            margin-top: 10px;
            font-size: 16px;
            color: #333;
          }
          .product-price {
            font-weight: bold;
            margin-top: 5px;
          }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.product-slider', {
      slidesPerView: 1,
      spaceBetween: 10,
      loop: true,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      breakpoints: {
        640: {
          slidesPerView: 2,
        },
        1024: {
          slidesPerView: 2,
        },
      },
      lazy: {
        loadPrevNext: true,
      },
    });
  });
</script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('.collection-tabs__tab');
    const panels = document.querySelectorAll('.collection-tabs__panel');
    const activeTab = localStorage.getItem('activeTab') || tabs[0].dataset.tab;
    
    tabs.forEach(tab => {
      if (tab.dataset.tab === activeTab) {
        tab.classList.add('active');
      }
    });

    panels.forEach(panel => {
      if (panel.dataset.panel === activeTab) {
        panel.classList.add('active');
      }
    });

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetPanel = document.querySelector(`[data-panel="${tab.dataset.tab}"]`);
        
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        
        tab.classList.add('active');
        targetPanel.classList.add('active');

        localStorage.setItem('activeTab', tab.dataset.tab);
      });

      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          const nextTab = tab.nextElementSibling || tabs[0];
          nextTab.focus();
          nextTab.click();
        } else if (e.key === 'ArrowLeft') {
          const prevTab = tab.previousElementSibling || tabs[tabs.length - 1];
          prevTab.focus();
          prevTab.click();
        }
      });
    });

    // Add to Cart Functionality
    const addToCartButtons = document.querySelectorAll('.add-to-cart');
    addToCartButtons.forEach(button => {
      button.addEventListener('click', function() {
        const productId = this.dataset.productId;
        const formData = {
          id: productId,
          quantity: 1
        };

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(formData)
        })
        .then(response => {
          if (!response.ok) {
            throw new Error('Network response was not ok');
          }
          return response.json();
        })
        .then(data => {
          console.log('Added to cart:', data);
          // Optional: Show a message or update the cart icon
          alert('Product added to cart!');
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          alert('There was an error adding the product to the cart.');
        });
      });
    });
  });
</script>
