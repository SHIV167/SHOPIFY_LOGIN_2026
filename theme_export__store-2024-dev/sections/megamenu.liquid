     .mobile-menu {
        padding-left: 15px;
        padding-right: 15px;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 9999;
        visibility: visible;
        width: calc(100vw - 65px);
        height: 100vh;
        background: white;
        box-shadow: none;
        overflow: auto;
        transform: translate(calc(-100vw + 65px));
        transition: 0.5s cubic-bezier(0.645, 0.045, 0.355, 1);
     }

     .close-nav {
        display: flex;
        justify-content: flex-start;
        padding: 20px 0 0;
        align-items: center;
     }

     .mobile-nav-items {
        display: flex;
        flex-direction: column;
        width: 100%;
