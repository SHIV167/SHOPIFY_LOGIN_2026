     .has_mobile_dropdown.active .expand-bar {
        transform: rotate(180deg);
     }

     .has_mobile_dropdown.active .expand-bar:after {
        height: 0;
        transform: rotate(180deg);
     }

     .mobile-dropdown-item.active .expand-bar {
        transform: rotate(180deg);
     }
     .mobile-dropdown-item.active .expand-arrow.right {
        transform: rotate(45deg);
     }

     .mobile-dropdown-item.active .expand-bar:after {
        transform: rotate(180deg);
     }

     /************************* for arrow Icon ***********************/

     .expand-arrow {
        border: solid #000;
        border-width: 0 1px 1px 0;
        display: inline-block;
        padding: 4px;
     }

     .has_mobile_dropdown.mobile-nav-links {
        display: flex;
        align-items: center;
        justify-content: space-between;
     }

     .expand-arrow.right {
        transform: rotate(-45deg);
        transition: all 0.5s ease;
     }
     .has_mobile_dropdown.active .expand-arrow.right {
