     .mobile-main_link span {
        font-size: 14px;
        text-transform: capitalize;
     }

     .expand-bar:after {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        transform: rotate(90deg);
        transition: all 0.5s ease;
        width: 12px;
        height: 1px;
        background-color: #000;
     }
     .expand-bar {
        width: 12px;
        height: 1px;
        background-color: #000;
        position: absolute;
        top: 50%;
        right: 0;
        transition: all 0.5s ease;
