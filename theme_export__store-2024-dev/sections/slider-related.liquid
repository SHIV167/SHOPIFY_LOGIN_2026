<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.featured_slider_new', {
        navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      slidesPerView: 1,
      spaceBetween: 10,
      loop: true,
      autoplay: {
        delay: 5000,
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      breakpoints: {
        640: {
          slidesPerView: 2,
        },
        1024: {
          slidesPerView: 4,
        },
      },
      lazy: {
        loadPrevNext: true,
      },
    });
  });
</script>
<style>
    .swiper-button-next,
  .swiper-button-prev {
    position: absolute;
    top: 50%;
    width: 40px;
    height: 40px;
    margin-top: -20px;
    z-index: 10;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background-color: rgba(0,0,0,0.5);
    border-radius: 50%;
  }
  .swiper-button-next {
    right: 10px;
  }
  .swiper-button-prev {
    left: 10px;
  }
  .swiper-button-next:after,
  .swiper-button-prev:after {
    content: none;
  }
  .swiper-pagination {
    position: relative;
    margin-top: 10px;
  }

  @media (max-width: 767px) {
    .swiper-button-next,
    .swiper-button-prev {
      width: 30px;
      height: 30px;
    }
    .swiper-button-next svg,
    .swiper-button-prev svg {
      width: 20px;
      height: 20px;
    }
  }
        .fcs_sec{
    Padding: 2em 0;
  }
  .fcs_sec .section-heading {
      margin-bottom: 15px;
  }
  .fcs_sec .section-heading h3 {
      margin-bottom: 10px;
  }
  .featured_slider_new {
      overflow: hidden;
    	position: relative;
  }
  .featured_slider_new .swiper-slide {
      box-shadow: none !important;
      text-align:center;
  }
  .featured_slider_new .product_discount {
      position: absolute;
      min-width: 50px;
      height: 30px;
      background: #e4572e;
      color: #fff;
      font-size: 13px;
      text-align: center;
      letter-spacing: .05em;
      line-height: 30px;
      z-index: 2;
  }
  .featured_slider_new .product_title {
      color: #1b1b1b;
      font-size: 16px;
      margin: 10px 0 5px;
      line-height: 26px;
      font-weight: 500;
      display: block;
  }
  .featured_slider_new .product_price {
      color: #929292;
      font-size: 16px;
      margin-bottom: 5px;
  }
  .featured_slider_new + .btn_container{
  	margin: 30px auto 0;
  }
  .featured_slider_new + .btn_container a {
      background: #e3572e;
      color: #fff;
      font-size: 16px;
      line-height: 1;
      text-transform: uppercase;
      padding: 14px 30px;
      display: inline-block;
  }
  .featured_slider_new .product-card__price {
      color: #929292;
      text-align: center;
    	margin-bottom: 5px;
  }
  .product_rating.text-left {
      text-align: center !important;
  }
  .featured_slider_new .product-card__promo-price {
      font-weight: 400;
  }
  .featured_slider_new .product-card__availability {
      text-align: left;
      font-weight: 400 !important;
      letter-spacing: 1px;
  }
  .featured_slider_new .swiper-button-prev {
      left: 6px !important;
  }
  .featured_slider_new .swiper-button-next {
    right: 6px !important;
  }
</style>
<section class="fcs_sec collection_tabs">
  <div class="page-width">
    <div class="section-heading text-center">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
    {%- assign collection = collections[section.settings.collection] -%}

    <div class="featured_slider_new">
      <div class="swiper-wrapper">
        {% for product in collection.products limit: 15 %}
          <div class="swiper-slide">
            <a class="product_img_link" href="{{ product.url }}">
              <div class="reveal">
                {% if product.compare_at_price > product.price and settings.promotion_tag %}
                  <div class="product_discount" aria-hidden="true" accesskey>
                    {% if settings.promo_text_or_pourc == '1' %}
                      {{ settings.promo_text }}
                    {% else %}
                      {% if product.compare_at_price_max != product.compare_at_price_min %}
                        {% assign compare_old_count = 0 %}
                        {% assign compare_new_count = 0 %}
                        {% for variant in product.variants %}
                          {% if variant.compare_at_price > variant.price %}
                            {% capture compare_new_count %}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price| ceil }}{% endcapture %}
                            <script>
                              if({{compare_new_count}} > {{compare_old_count}}){ {% assign compare_old_count = compare_new_count %} }
                            </script>
                          {% endif %}
                        {% endfor %}
                        <span>{{ 'products.product.upto' | t }} -{{ compare_old_count | append: '%' }}</span>
                      {% else %}
                        <span
                          >-
                          {{-
                            product.compare_at_price
                            | minus: product.price
                            | times: 100.0
                            | divided_by: product.compare_at_price
                            | ceil
                          -}}
                          %</span
                        >
                      {% endif %}
                    {% endif %}
                  </div>
                {% endif %}
                {% if product.images.size > 1 %}
                  <img class="product_img_new lazyload" src="{{ product.featured_image.src | img_url: 'original' }}">
                  <img
                    class="product_img_new hidden lazyload"
                    src="{{ product.images[1] | product_img_url: 'original' }}"
                  >
                {% else %}
                  <img
                    src="{{ product.featured_image.src | img_url: 'original' }}"
                    alt="{{ product.featured_image.alt | escape }}"
                  >
                {% endif %}
              </div>
            </a>
            <a class="product_title" href="{{ product.url }}">{{ product.title }}</a>
            {% if product.available %}
              <div class="product-card__price">
                {% if product.compare_at_price > product.price %}
                  {% if product.price_varies %}
                    {% assign sale_price = product.price | money %}
                    <span class="product-card__promo-price">
                      {{- 'products.product.on_sale_from_html' | t: price: sale_price -}}
                    </span>
                  {% else %}
                    <span class="product-card__promo-price">{{ product.price | money }}</span>
                    <s class="product-card__regular-price">{{ product.compare_at_price | money }}</s>
                  {% endif %}
                {% else %}
                  {% if product.price_varies %}
                    {% assign price = product.price | money %}
                    {{ 'products.product.from_text_html' | t: price: price }}
                  {% else %}
                    {{ product.price | money }}
                  {% endif %}
                {% endif %}
                {%- unless product.price_varies -%}
                  {%- if current_variant.unit_price_measurement -%}
                    {% include 'product-unit-price',
                      product_variant: current_variant,
                      wrapper_class: 'product-card__unit-price'
                    %}
                  {%- endif -%}
                {%- endunless -%}
              </div>
            {% else %}
              <div class="product-card__availability">
                {{ 'products.product.sold_out' | t }}
              </div>
            {% endif %}
            {% if settings.app_reviews != '0' %}
              <div class="product_rating text-left"></div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="swiper-button-next">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </div>
      <div class="swiper-button-prev">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </div>
      <div class="swiper-pagination"></div>
    </div>
    {% if section.settings.button_label != blank %}
      <div class="btn_container text-center">
        <a href="{{section.settings.collection_url}}">{{ section.settings.button_label }}</a>
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
 {
   "name": "Collection Slider",
   "settings": [
       {
         "type": "text",
         "id": "heading",
         "label": "Heading"
       },
	{
         "type": "textarea",
         "id": "subheading",
         "label": "Sub Heading"
       },
	{
         "id": "collection",
         "type": "collection",
         "label": "Select Collection"
       },
	{
         "type": "text",
         "id": "button_label",
         "label": "Button Label"
       },
	{
         "type": "url",
         "id": "collection_url",
         "label": "Button Url"
       }
],
     "presets": [
      {
        "name": "Collection Slider",
        "category": "Collection Slider"
      }
     ]
 }
{% endschema %}
