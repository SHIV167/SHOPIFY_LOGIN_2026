{% schema %}
{
  "name": "Responsive Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_banner_image",
      "label": "Desktop Banner Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_banner_image",
      "label": "Mobile Banner Image"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Banner Heading",
      "default": "Welcome to our Store!"
    },
    {
      "type": "text",
      "id": "banner_subheading",
      "label": "Banner Subheading",
      "default": "Explore our latest collection."
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Button Link"

    },
    {
      "type": "text",
      "id": "banner_button_text",
      "label": "Button Text",
      "default": "Shop Now"
    }
  ],
  "presets": [
    {
      "name": "Responsive Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
{% stylesheet %}
  <style>
    .responsive-banner {
      position: relative;
      text-align: center;
      color: white;
    }
    .responsive-banner img {
      width: 100%;
      height: auto;
    }
    .responsive-banner-content {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      padding: 20px;
      background: rgba(0, 0, 0, 0.5); /* Optional: for better text visibility */
    }
    .responsive-banner-content h1 {
      font-size: 2em;
      margin: 0;
    }
    .responsive-banner-content p {
      font-size: 1.2em;
      margin: 10px 0;
    }
    .responsive-banner-content a {
      padding: 10px 20px;
      background-color: #fff;
      color: #000;
      text-decoration: none;
      border-radius: 5px;
    }
    @media only screen and (max-width: 768px) {
      .responsive-banner img.desktop {
        display: none;
      }
      .responsive-banner img.mobile {
        display: block;
      }
    }
    @media only screen and (min-width: 769px) {
      .responsive-banner img.desktop {
        display: block;
      }
      .responsive-banner img.mobile {
        display: none;
      }
    }
  </style>
{% endstylesheet %}

<div class="responsive-banner">
  <img src="{{ section.settings.desktop_banner_image | img_url: 'master' }}" class="desktop" alt="Desktop Banner">
  <img src="{{ section.settings.mobile_banner_image | img_url: 'master' }}" class="mobile" alt="Mobile Banner">
  <div class="responsive-banner-content"></div>
</div>
