            <style>
                                  .contact_form {
                  width: 100%;
                  display: inline-block;
                  text-align: center;
                  padding: 30px 0;
                  background: #f9f9f9;
              }

              .contact_form h4 {
                  font-size: 30px;
                  color: #333;
                  margin: 0 0 30px;
                  font-weight: bold;
              }

              .contact_form h5 {
                  font-size: 18px;
                  color: #333;
                  margin: 20px 0;
                  font-weight: bold;
              }

              .modal-content {
                  border-radius: 20px;
                  text-align: left;
                  border: none !important;
                  background: #fff;
                  box-shadow: 0 0 20px rgba(0,0,0,0.1);
              }

              .modal-body {
                  padding: 30px;
              }

              .form-group {
                  margin-bottom: 20px;
              }

              input[type="text"],
              input[type="email"],
              input[type="number"] {
                  border: 1px solid #ddd;
                  border-radius: 5px;
                  background: #f8f8f8;
                  padding: 10px 15px;
                  width: 100%;
                  height: 45px;
                  font-size: 16px;
                  transition: all 0.3s ease;
              }

              input[type="text"]:focus,
              input[type="email"]:focus,
              input[type="number"]:focus {
                  outline: none;
                  border-color: #4CAF50;
                  box-shadow: 0 0 5px rgba(76,175,80,0.5);
              }

              label {
                  display: inline-block;
                  margin-bottom: 8px;
                  font-size: 16px;
                  color: #333;
                  font-weight: 500;
              }

              .box {
                  padding: 20px;
                  margin-top: 20px;
                  background-color: #f0f0f0;
                  border-radius: 5px;
                  border: 1px solid #ddd;
              }

              .btn-infoo {
                  background-color: #4CAF50;
                  color: white;
                  padding: 12px 25px;
                  border: none;
                  border-radius: 5px;
                  cursor: pointer;
                  font-size: 18px;
                  font-weight: bold;
                  transition: all 0.3s ease;
              }

              .btn-infoo:hover {
                  background-color: #45a049;
                  transform: translateY(-2px);
                  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
              }

              #formMessage {
                  margin-top: 20px;
                  font-weight: bold;
              }

              /* Custom styles for radio buttons and checkboxes */
              input[type="radio"],
              input[type="checkbox"] {
                  margin-right: 10px;
              }

              /* Responsive adjustments */
              @media (max-width: 768px) {
                  .contact_form .row {
                      flex-direction: column;
                  }

                  .contact_form .col-lg-6,
                  .contact_form .col-sm-6 {
                      width: 100%;
                      margin-bottom: 20px;
                  }

                  .modal-content {
                      border-radius: 10px;
                  }

                  .modal-body {
                      padding: 20px;
                  }

                  .contact_form h4 {
                      font-size: 24px;
                  }
              }
            </style>
            <script>
              $(document).ready(function () {
                  // Show corresponding health issue boxes (existing code)
                  $('input[name="healthissues"]').on('change', function () {
                      $('.box').hide();
                      const selectedHealthIssue = $(this).val();
                      $('.' + selectedHealthIssue).show();
                  });

                  // AJAX form submission
                  $('#consultationForm').on('submit', function (e) {
                      e.preventDefault();

                      // Disable button and change text
                      $('#submitBtn').prop('disabled', true).val('Please wait...');

                      // Store the form data
                      var formData = $(this).serialize();

                      // Set a timeout to ensure "Please wait" shows for at least 4 seconds
                      setTimeout(function() {
                          $.ajax({
                              url: 'process_form.php',
                              type: 'POST',
                              data: formData,
                              dataType: 'json',
                              success: function (response) {
                                  if (response.status === 'success') {
                                      $('#formMessage').html('<div class="alert alert-success">' + response.message + '</div>');
                                      $('#consultationForm')[0].reset();
                                  } else {
                                      $('#formMessage').html('<div class="alert alert-danger">' + response.message + '</div>');
                                  }
                              },
                              error: function () {
                                  $('#formMessage').html('<div class="alert alert-danger">An error occurred. Please try again.</div>');
                              },
                              complete: function() {
                                  // Re-enable the submit button
                                  $('#submitBtn').prop('disabled', false).val('Submit');
                              }
                          });
                      }, 4000); // 4000 milliseconds = 4 seconds
                  });
              });
            </script>
