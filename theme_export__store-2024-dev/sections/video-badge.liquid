{% schema %}
{
  "name": "Video Badge and Popup",
  "settings": [
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#008000"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Video Badge and Popup"
    }
  ]
}
{% endschema %}

{% style %}
    /* Base styles for the video popup */
    .video-popup {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.8);
      z-index: 1000;
      justify-content: center;
      align-items: center;
      padding: 20px; /* Add padding to create space around the video */
      box-sizing: border-box;
    }

    .video-popup.active {
      display: flex;
    }

    .video-popup-content {
    position: relative;
    width: 90%; /* Default width for smaller screens */
    max-width: 800px; /* Max width for larger screens */
    margin: 0 auto; /* Center the content */
    background: #000; /* Background color for the video container */
    border-radius: 8px; /* Optional: add rounded corners */
    overflow: hidden; /* Hide any overflow */
  }

  .video-popup-close {
    position: absolute;
    top: 0px; /* Position the close button above the video container */
    right: 0px; /* Move the button slightly out of the container */
    color: white;
    font-size: 30px; /* Large font size for better visibility */
    cursor: pointer;
    background: green; /* Semi-transparent background */
    border-radius: 50%; /* Circular button */
    padding: 0px 15px; /* Padding inside the button */
    z-index: 10; /* Ensure it's above other elements */
    transition: background 0.3s ease; /* Smooth transition on hover */
  }

  .video-popup-close:hover {
    background: rgba(0, 0, 0, 0.8); /* Darker background on hover */
  }

  /* Responsive adjustments for smaller screens */
  @media (max-width: 768px) {
    .video-popup-close {
      top: -20px; /* Adjust close button position */
      right: -20px; /* Adjust close button position */
      font-size: 25px; /* Smaller font size */
    }
  }

  /* Responsive adjustments for very small screens */
  @media (max-width: 480px) {
    .video-popup-close {
      top: -15px; /* Adjust close button position */
      right: -15px; /* Adjust close button position */
      font-size: 20px; /* Smaller font size */
      padding: 3px 10px; /* Smaller padding */
    }
  }

    .video-popup iframe, .video-popup video {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9; /* Maintains the aspect ratio for both video and iframe */
    }

    /* Responsive adjustments for smaller screens */
    @media (max-width: 768px) {
      .video-popup-content {
        width: 100%; /* Full width on mobile */
        max-width: none; /* Remove max width restriction */
      }

      .video-popup-close {
        top: -30px; /* Adjust close button position */
        font-size: 25px; /* Adjust font size */
      }

      .video-popup iframe, .video-popup video {
        width: 100%;
        height: auto; /* Maintain auto height for flexibility */
        aspect-ratio: 1 / 1;
      }
    }

    /* Responsive adjustments for very small screens */
    @media (max-width: 480px) {
      .video-popup-content {
        width: 100%;
        padding: 0; /* Remove padding to use full screen width */
      }

      .video-popup iframe, .video-popup video {
        height: 200px; /* Set a specific height for very small screens */
      }
    }
{% endstyle %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  const productCards = document.querySelectorAll('.product-card');
  const productImages = document.querySelectorAll('.product-image-container');
  
  function addVideoBadge(element, videoUrl) {
    // Check if badge already exists
    if (element.querySelector('.video-badge')) return;

    const badge = document.createElement('div');
    badge.className = 'video-badge';
    badge.innerHTML = `                     <svg
                        version="1.1"
                        id="Layer_1"
                        x="0px"
                        y="0px"
                        viewBox="0 0 41 24.6"
                        style="enable-background:new 0 0 41 24.6;"
                        xml:space="preserve"
                        sodipodi:docname="e64ef4568d68bd8debd351a537cbaa35.svg"
                        xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape"
                        xmlns:sodipodi="http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd"
                        xmlns="http://www.w3.org/2000/svg"
                        xmlns:svg="http://www.w3.org/2000/svg"
                      >
                        <defs
                           id="defs11" /><sodipodi:namedview
                           id="namedview9"
                           pagecolor="#ffffff"
                           bordercolor="#666666"
                           borderopacity="1.0"
                           inkscape:pageshadow="2"
                           inkscape:pageopacity="0.0"
                           inkscape:pagecheckerboard="0" />
                        <style
                           type="text/css"
                           id="style2">
                        	.st0{fill-rule:evenodd;clip-rule:evenodd;fill:none;stroke:#C46128;stroke-miterlimit:10;}
                        </style>
                        <path
                           class="st0"
                           d="M6.1,1.3h15.7c2.7,0,4.9,2.2,4.9,4.9v12.3c0,2.7-2.2,4.9-4.9,4.9H6.1c-2.7,0-4.9-2.2-4.9-4.9V6.2  C1.2,3.5,3.4,1.3,6.1,1.3z"
                           id="path4" />
                        <path
                           class="st0"
                           d="M37.2,3.7c1.5,0,2.6,1.2,2.6,2.6v12.1c0,1.5-1.2,2.6-2.6,2.6L29.7,17V7.7L37.2,3.7z"
                           id="path6" />
                      </svg>`;
    badge.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      showVideoPopup(videoUrl);
    });
    element.appendChild(badge);
  }

  function getEmbeddableUrl(videoUrl) {
    const videoIdMatch = videoUrl.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&]+)/);
    return videoIdMatch ? `https://www.youtube.com/embed/${videoIdMatch[1]}` : videoUrl;
  }

  function showVideoPopup(videoUrl) {
  const isYouTube = /youtube\.com|youtu\.be/.test(videoUrl);
  const popup = document.createElement('div');
  popup.className = 'video-popup';

  if (isYouTube) {
    const embeddableUrl = getEmbeddableUrl(videoUrl);
    popup.innerHTML = `
      <div class="video-popup-content">
        <span class="video-popup-close">&times;</span>
        <iframe src="${embeddableUrl}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    `;
  } else {
    popup.innerHTML = `
      <div class="video-popup-content">
        <span class="video-popup-close">&times;</span>
        <video controls>
          <source src="${videoUrl}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
    `;
  }

  document.body.appendChild(popup);
  setTimeout(() => popup.classList.add('active'), 10);

  // Close popup when clicking on the close button
  popup.querySelector('.video-popup-close').addEventListener('click', function() {
    closePopup(popup);
  });

  // Close popup when clicking on the background overlay
  popup.addEventListener('click', function(event) {
    // Check if the clicked element is the popup itself (not the content)
    if (event.target === popup) {
      closePopup(popup);
    }
  });
}

// Function to close and remove the popup
function closePopup(popup) {
  popup.classList.remove('active');
  setTimeout(() => popup.remove(), 300);
}


  productCards.forEach(card => {
    const videoUrl = card.dataset.productVideo;
    if (videoUrl) {
      addVideoBadge(card, videoUrl);
    }
  });

  productImages.forEach(image => {
    const videoUrl = image.dataset.productVideo;
    if (videoUrl) {
      addVideoBadge(image, videoUrl);
    }
  });
});
</script>
