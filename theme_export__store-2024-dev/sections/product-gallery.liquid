{%- style -%}
  /* ... previous styles remain the same ... */
{%- endstyle -%}

<div
  class="product-slick-gallery"
  data-section-id="{{ section.id }}"
  data-product-handle="{{ product.handle }}"
  data-enable-video-looping="{{ section.settings.enable_video_looping }}"
>
  <div class="main-slider">
    {%- for media in product.media -%}
      <div class="product__media-item" data-media-id="{{ media.id }}">
        {%- case media.media_type -%}
          {%- when 'image' -%}
            {%- assign img_url = media | image_url: width: 1500 -%}
            <img
              src="{{ img_url }}"
              alt="{{ media.alt | escape }}"
              class="product__media-image"
              loading="lazy"
              width="{{ media.width }}"
              height="{{ media.height }}"
              sizes="(min-width: 1100px) 1500px, (min-width: 990px) calc(100vw - 400px), 100vw"
              srcset="
                {%- if media.width >= 300 -%}{{ media | image_url: width: 300 }} 300w,{%- endif -%}
                {%- if media.width >= 600 -%}{{ media | image_url: width: 600 }} 600w,{%- endif -%}
                {%- if media.width >= 900 -%}{{ media | image_url: width: 900 }} 900w,{%- endif -%}
                {%- if media.width >= 1200 -%}{{ media | image_url: width: 1200 }} 1200w,{%- endif -%}
                {%- if media.width >= 1500 -%}{{ media | image_url: width: 1500 }} 1500w,{%- endif -%}
                {%- if media.width >= 1800 -%}{{ media | image_url: width: 1800 }} 1800w{%- endif -%}
              "
            >
          {%- when 'video' -%}
            <video
              playsinline
              {% if section.settings.enable_video_looping %}
                loop
              {% endif %}
              controls
              preload="none"
              poster="{{ media.preview_image | image_url: width: 1500 }}"
            >
              <source src="{{ media.sources[1].url }}" type="video/mp4">
            </video>
            <span class="thumbnail-badge video-badge">
              {%- render 'icon-play' -%}
            </span>
          {%- when 'external_video' -%}
            {{ media | external_video_tag }}
            <span class="thumbnail-badge video-badge">
              {%- render 'icon-play' -%}
            </span>
          {%- when 'model' -%}
            {{ media | model_viewer_tag }}
            <span class="thumbnail-badge model-badge">
              {%- render 'icon-3d-model' -%}
            </span>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="thumbnail-slider">
    {%- for media in product.media -%}
      <div class="thumbnail" data-media-id="{{ media.id }}">
        {%- assign thumb_url = media.preview_image | image_url: width: 150 -%}
        <img
          src="{{ thumb_url }}"
          alt="{{ media.alt | escape }}"
          loading="lazy"
          width="150"
          height="150"
        >
        {%- if media.media_type != 'image' -%}
          <span class="thumbnail-badge">
            {%- case media.media_type -%}
              {%- when 'video', 'external_video' -%}
                {%- render 'icon-play' -%}
              {%- when 'model' -%}
                {%- render 'icon-3d-model' -%}
            {%- endcase -%}
          </span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  // ... previous JavaScript remains the same ...
</script>

{% schema %}
{
  "name": "Product Gallery",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Enable video looping",
      "default": false
    }
  ]
}
{% endschema %}
